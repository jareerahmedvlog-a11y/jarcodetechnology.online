# Copy to .env.local for local development. Never commit real secrets.
# On Vercel: Project → Settings → Environment Variables

# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://jarcodetechnology.online

# Optional public contact email display
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Admin bootstrap (first boot hashes into data/admin/credentials.json when disk is writable) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
AUTH_SESSION_SECRET=

# --- Optional contact delivery ---
CONTACT_WEBHOOK_URL=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# --- Vercel Blob (recommended on Vercel so /demo/[slug] survives deploys) ---
# Vercel → Storage → Blob → Create → token is auto-added as BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN=

# --- JARCODE AI (server-only — never use NEXT_PUBLIC_ for these) ---
# Leave empty here. Put the real key only in .env.local (local) or Vercel env (production).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FAST_MODEL=gpt-4o-mini
OPENAI_CAPABLE_MODEL=gpt-4o
OPENAI_WORKSPACE_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=gpt-image-2.6-flare
OPENAI_IMAGE_EDIT_MODEL=gpt-image-2.6-sunburst
OPENAI_HISTORY_MESSAGES=10
OPENAI_SIMPLE_MAX_TOKENS=700
OPENAI_COMPLEX_MAX_TOKENS=2200
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=alloy
OPENAI_MONTHLY_BUDGET_USD=25
OPENAI_CHAT_DAILY_LIMIT=120
OPENAI_VOICE_DAILY_LIMIT=40
OPENAI_VOICE_MAX_MINUTES=20
OPENAI_IMAGE_DAILY_LIMIT=20
OPENAI_FILE_DAILY_LIMIT=40
OPENAI_SEARCH_DAILY_LIMIT=40
OPENAI_MAX_UPLOAD_MB=20
OPENAI_IMAGE_COST_USD=0.04
OPENAI_ALERT_EMAIL=

# --- AI Video (Luma — separate from OpenAI; optional) ---
VIDEO_GENERATION_API_KEY=
VIDEO_PROVIDER=luma
VIDEO_MODEL=ray-2
VIDEO_FLASH_MODEL=ray-flash-2
VIDEO_DAILY_LIMIT=8
VIDEO_MONTHLY_LIMIT=40
VIDEO_PER_USER_DAILY_LIMIT=3
VIDEO_COST_PER_SECOND_USD=0.10
VIDEO_RETENTION_HOURS=168
VIDEO_PUBLIC_BASE_URL=

# Cookie Secure: true on HTTPS (Vercel). false only for local LAN HTTP.
COOKIE_SECURE=true
